@app.post("/api/generate-part1")
async def generate_part1_api(files: List[UploadFile] = File(...)):
    try:
        config = TOEIC_CONFIG.get("part_1")
        
        # --- LOGIC AUTO-TAGGING PART 1 ---
        db = get_db_connection()
        cursor = db.cursor(dictionary=True)
        cursor.execute("SELECT id, ten_dang FROM danh_muc_dang_bai WHERE part = 'part_1'")
        danh_sach_dang = cursor.fetchall()
        menu_dang_bai = ", ".join([f"ID {r['id']}: '{r['ten_dang']}'" for r in danh_sach_dang])
        db.close()

        strict_rule = f"""
\nYÊU CẦU AUTO-TAGGING: Dựa vào nội dung bức ảnh, hãy tự phân tích xem nó thuộc dạng nào trong Menu dưới đây, và THÊM trường "id_dang_bai" (chứa số ID tương ứng) vào JSON.
MENU DẠNG BÀI HIỆN CÓ: [{menu_dang_bai}].
"""
        system_prompt = config["system_prompt"] + strict_rule
        model = genai.GenerativeModel('gemini-2.5-flash')
        
        danh_sach_cau_hoi = [] 
        
        for index, file in enumerate(files):
            image_bytes = await file.read()
            image_parts = [{"mime_type": file.content_type, "data": image_bytes}]
            
            # Mã hóa ảnh để truyền về giao diện
            encoded_string = base64.b64encode(image_bytes).decode('utf-8')
            img_data_uri = f"data:{file.content_type};base64,{encoded_string}"
            
            print(f"Đang xử lý ảnh {index + 1}/{len(files)}...")
            response = model.generate_content([image_parts[0], system_prompt])
            
            # ==================================================
            # BỘ LỌC JSON CHỐNG NHIỄU (ĐÃ ĐƯỢC NÂNG CẤP)
            # ==================================================
            raw_text = response.text.strip()
            
            # Bước 1: Dọn dẹp thẻ Markdown (Nếu AI chèn vào)
            if raw_text.startswith("```json"):
                raw_text = raw_text[7:]
            elif raw_text.startswith("```"):
                raw_text = raw_text[3:]
                
            if raw_text.endswith("```"):
                raw_text = raw_text[:-3]
                
            raw_text = raw_text.strip()
            
            # Bước 2: Moi móc chính xác ruột JSON bằng Regex
            match = re.search(r'(\{.*\}|\[.*\])', raw_text, re.DOTALL)
            clean_json = match.group(1) if match else raw_text
            # ==================================================
            
            try:
                parsed_data = json.loads(clean_json)
                
                # --- SỬA LỖI NHÉT ẢNH VÀO JSON ---
                # Kiểm tra nếu AI trả về Mảng (List) hay Khối Object (Dict)
                if isinstance(parsed_data, list) and len(parsed_data) > 0:
                    parsed_data[0]['hinh_anh'] = img_data_uri
                    danh_sach_cau_hoi.extend(parsed_data)
                elif isinstance(parsed_data, dict):
                    parsed_data['hinh_anh'] = img_data_uri
                    danh_sach_cau_hoi.append(parsed_data)
            
            except json.JSONDecodeError as e:
                print(f"❌ Lỗi parse JSON ở file {file.filename}")
                print(f"   Chi tiết lỗi: {e}")
                print(f"   Dữ liệu thô AI trả về (để debug): {response.text}") # In cái này ra để biết tại sao nó lỗi
                
        # Trả về danh sách JSON thô
        return {"status": "success", "data": danh_sach_cau_hoi}
        
    except Exception as e:
        print(f"Lỗi hệ thống: {e}")
        return {"status": "error", "message": str(e)}



