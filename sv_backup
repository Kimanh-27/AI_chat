@app.post("/api/generate-questions")
async def generate_questions_api(req: QuestionRequest):
    try:
        # 1. Lấy prompt chuẩn từ file config dựa vào tên part (VD: part_5)
        config = TOEIC_CONFIG.get(req.part)
        if not config:
            return {"status": "error", "message": "Part này chưa được hỗ trợ."}

        # 2. Ép AI sinh đúng số lượng câu hỏi mà giáo viên yêu cầu
        system_prompt = config["system_prompt"] + f"\n\nYêu cầu bổ sung: Hãy sinh ra CHÍNH XÁC {req.num_questions} câu hỏi."
        
