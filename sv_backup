@app.post("/api/generate_toeic")
async def generate_toeic(
    part: str = Form(...), 
    num_questions: int = Form(None),
    image: UploadFile = File(None)
):
    try:
        # 1. Lấy cấu hình từ nhà kho
        config = TOEIC_CONFIG.get(part)
        if not config:
            return {"status": "error", "message": "Không tìm thấy cấu hình cho Part này."}

        # 2. Xử lý số lượng câu hỏi
        q_count = num_questions if num_questions else config["default_questions"]
        
        # --- LOGIC AUTO-TAGGING (Tự động gán nhãn) ---
        conn = get_db_connection()
        cursor = conn.cursor(dictionary=True)
        # Lấy các dạng bài thuộc Part hiện tại từ Bảng chung
        cursor.execute("SELECT id, ten_dang FROM danh_muc_dang_bai WHERE part = %s", (part,))
        danh_sach_dang = cursor.fetchall()
        menu_dang_bai = ", ".join([f"ID {r['id']}: '{r['ten_dang']}'" for r in danh_sach_dang])
        conn.close()

        strict_rule = f"""
\nYÊU CẦU AUTO-TAGGING (RẤT QUAN TRỌNG): Hãy sinh ra một bộ câu hỏi trộn lẫn các dạng chuẩn TOEIC. 
Với MỖI câu hỏi được sinh ra, bạn phải tự phân tích xem nó thuộc dạng nào trong Menu dưới đây, và THÊM trường "id_dang_bai" (chứa số ID tương ứng) vào cục JSON của câu hỏi đó. 
MENU DẠNG BÀI HIỆN CÓ: [{menu_dang_bai}].
"""
        # Dùng .replace thay cho .format để tránh lỗi với ngoặc nhọn của JSON
        final_prompt = config["system_prompt"].replace("{num_questions}", str(q_count)) + strict_rule

        # 3. Khởi tạo model Gemini tương ứng
        if config["requires_image"]:
            if not image:
                return {"status": "error", "message": f"{part} yêu cầu phải có ảnh!"}
            
            # Đọc file ảnh để gửi cho Gemini
            image_bytes = await image.read()
            image_parts = [{"mime_type": image.content_type, "data": image_bytes}]
            
            model = genai.GenerativeModel('gemini-2.5-flash') # Model hỗ trợ vision
            response = model.generate_content([image_parts[0], final_prompt])
        else:
            model = genai.GenerativeModel('gemini-2.5-flash') 
            response = model.generate_content(final_prompt)

        # 4. Làm sạch kết quả trả về (Cắt bỏ các ký hiệu markdown dư thừa của AI)
        raw_text = response.text.strip()
        
        # Dùng Regex để tìm phần văn bản nằm gọn trong dấu ngoặc vuông [...] hoặc ngoặc nhọn {...}
        match = re.search(r'(\[.*\]|\{.*\})', raw_text, re.DOTALL)
        
        if match:
            clean_json = match.group(1)
            parsed_data = json.loads(clean_json)
            return {"status": "success", "data": parsed_data}
        else:
            # Nếu AI thực sự bị lỗi không sinh ra JSON
            return {"status": "error", "message": "Nova không tạo ra được cấu trúc đề thi. Vui lòng thử lại!"}
    except Exception as e:
        return {"status": "error", "message": str(e)}

